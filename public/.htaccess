DirectoryIndex index.php
AddDefaultCharset UTF-8

# Cabeceras de Seguridad y Resiliencia
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compresión GZIP / Deflate para recursos de la landing page
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caché óptima para recursos estáticos (imágenes, fuentes, css, js)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Compatibilidad con rutas anteriores hacia assets/
    RewriteRule ^images/(.*)$ assets/img/$1 [L]
    RewriteRule ^css/(.*)$ assets/css/$1 [L]
    RewriteRule ^js/(.*)$ assets/js/$1 [L]

    # Permitir acceso directo a archivos y directorios existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Enrutar todo lo demás a index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
