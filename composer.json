{
    "name": "marinails/spa-boutique",
    "description": "Sitio web boutique y sistema de citas para Mari Nails Spa en arquitectura MVC con PHP 8 y Composer",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Mari Nails Spa",
            "email": "contacto@marinailsspa.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
